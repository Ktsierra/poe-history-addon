{
  "manifest_version": 3,
  "name": "PoE2 Trade History",
  "short_name": "PoE2 History",
  "version": "0.3.0",
  "description": "Restores the Merchant History tab on the Path of Exile 2 trade site. Not affiliated with or endorsed by Grinding Gear Games.",
  "homepage_url": "https://github.com/Ktsierra/poe-history-addon",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "https://*.pathofexile.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade2*",
        "https://*.pathofexile.com/trade2*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "poe2-trade-history@ktsierra",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
